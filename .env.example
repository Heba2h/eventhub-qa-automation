# Copy to .env and adjust. Every variable is optional.

# Target environment
BASE_URL=https://eventhub.rahulshettyacademy.com
API_URL=https://api.eventhub.rahulshettyacademy.com/api

# Test accounts. Leave empty to let the framework register its own accounts on first run
# (credentials are then cached in .auth/ and reused on later runs).
# Two accounts are needed: "secondary" plays the other user in authorization tests.
EVENTHUB_USER_EMAIL=
EVENTHUB_USER_PASSWORD=
EVENTHUB_SECONDARY_EMAIL=
EVENTHUB_SECONDARY_PASSWORD=

# Parallel workers (kept modest: the target is a shared public environment)
WORKERS=4
